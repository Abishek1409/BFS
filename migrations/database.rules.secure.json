{
  "rules": {
    ".read": false,
    ".write": false,

    "orders": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      ".indexOn": ["createdAt"],
      "$orderId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && (auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2' || (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['items', 'status', 'uid']) && (newData.hasChild('createdAt') || newData.hasChild('timestamp')))",
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "uid": { ".validate": "newData.isString()" },
        "orderNo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "table": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(pending|preparing|ready|served|billed)$/)" },
        "items": {
          "$i": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "qty": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 200" }
          }
        }
      }
    },

    "menuStock": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "$itemId": {
        ".validate": "$itemId.matches(/^[0-9]+$/) && newData.isBoolean() && newData.val() === false"
      }
    },

    "orderStatus": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "$orderId": {
        ".read": "auth != null"
      }
    },

    "liveMap": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "schemaVersion": { ".validate": "newData.isNumber()" },
      "tables": {
        "$table": {
          ".validate": "$table.matches(/^[0-9]+$/) && newData.hasChildren(['occupied'])",
          "number": { ".validate": "newData.isString() && newData.val() === $table" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "seats": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
          "occupied": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },
      "progress": {
        "$orderId": {
          ".validate": "newData.hasChildren(['table', 'createdAt', 'stage', 'paid', 'updatedAt'])",
          "orderNo": { ".validate": "newData.isString()" },
          "table": { ".validate": "newData.isString() && newData.val().length > 0" },
          "total": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "stage": { ".validate": "newData.isString() && newData.val().matches(/^(placed|preparing|ready|served)$/)" },
          "placedAt": { ".validate": "newData.isNumber()" },
          "preparingAt": { ".validate": "newData.isNumber()" },
          "readyAt": { ".validate": "newData.isNumber()" },
          "servedAt": { ".validate": "newData.isNumber()" },
          "paid": { ".validate": "newData.isBoolean()" },
          "paidAt": { ".validate": "newData.isNumber()" },
          "billNo": { ".validate": "newData.isString()" },
          "updatedAt": { ".validate": "newData.isNumber()" }
        }
      },
      "history": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$orderId": {
            ".validate": "newData.hasChildren(['table', 'createdAt', 'stage', 'closedAt'])",
            "stage": { ".validate": "newData.val() === 'served'" },
            "closedAt": { ".validate": "newData.isNumber()" }
          }
        }
      },
      "$other": { ".validate": false }
    }
  }
}
