{
  "rules": {
    ".read": false,
    ".write": false,

    "orders": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      ".indexOn": ["createdAt"],
      "$orderId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && (auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2' || (!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['items', 'status', 'uid']) && (newData.hasChild('createdAt') || newData.hasChild('timestamp')))",
        "timestamp": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "uid": { ".validate": "newData.isString()" },
        "orderNo": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "table": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(pending|preparing|ready|served|billed)$/) && (auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2' || newData.val() === 'pending')" },
        "items": {
          "$i": {
            ".validate": "newData.hasChildren(['name', 'qty', 'price'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "baseName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "qty": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
            "ice": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "sugar": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "size": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "orderType": { ".validate": "newData.isString() && newData.val().matches(/^(Dine In|Take Away)$/)" },
            "spec": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "orderAmendments": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "$orderId": {
        "$amendmentId": {
          ".write": "auth != null && (auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2' || (!data.exists() && newData.child('uid').val() === auth.uid && (root.child('orders').child($orderId).child('uid').val() === auth.uid || root.child('orderStatus').child($orderId).child('uid').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['uid', 'items', 'createdAt']) && newData.child('uid').isString() && newData.child('items').hasChildren() && newData.child('createdAt').isNumber() && (!newData.hasChild('billNo') || newData.child('billNo').isString() || newData.child('billNo').isNumber()) && (!newData.hasChild('billDate') || newData.child('billDate').isString()) && (!newData.hasChild('status') || newData.child('status').val().matches(/^(queued|updated|printed)$/)) && (!newData.hasChild('updatedAt') || newData.child('updatedAt').isNumber()) && (!newData.hasChild('printedAt') || newData.child('printedAt').isNumber()) && (!newData.hasChild('customerPrintedAt') || newData.child('customerPrintedAt').isNumber()) && (!newData.hasChild('kitchenPrintedAt') || newData.child('kitchenPrintedAt').isNumber())",
          "items": {
            "$i": {
              ".validate": "newData.hasChildren(['name', 'price', 'qty'])",
              "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
              "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
              "qty": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99" },
              "$other": { ".validate": false }
            }
          },
          "uid": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "billNo": { ".validate": "newData.isString() || newData.isNumber()" },
          "billDate": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.val().matches(/^(queued|updated|printed)$/)" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "printedAt": { ".validate": "newData.isNumber()" },
          "customerPrintedAt": { ".validate": "newData.isNumber()" },
          "kitchenPrintedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "menu": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "updatedAt": { ".validate": "newData.isNumber()" },
      "items": {
        "$itemId": {
          ".validate": "$itemId.matches(/^[0-9]+$/) && newData.hasChildren(['id', 'name', 'price', 'cat'])",
          "id": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
          "price": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000" },
          "cat": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
          "img": { ".validate": "newData.isString() && newData.val().length <= 300000 && (newData.val() === '' || newData.val().matches(/^(assets\\/|\\/assets\\/|data:image\\/(jpeg|png|webp);base64,)/))" },
          "emoji": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "specs": { "$i": { ".validate": "newData.isString() && newData.val().length <= 20" } },
          "available": { ".validate": "newData.isBoolean()" },
          "inStock": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },

    "menuStock": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "$itemId": {
        ".validate": "$itemId.matches(/^[0-9]+$/) && newData.isBoolean() && newData.val() === false"
      }
    },

    "orderStatus": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "$orderId": {
        ".read": "auth != null"
      }
    },

    "liveMap": {
      ".read": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      ".write": "auth != null && auth.uid === 'sUN0LfqxRZYyqHBZanmFx88fiDP2'",
      "schemaVersion": { ".validate": "newData.isNumber()" },
      "tables": {
        "$table": {
          ".validate": "$table.matches(/^[0-9]+$/) && newData.hasChildren(['occupied'])",
          "number": { ".validate": "newData.isString() && newData.val() === $table" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "seats": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
          "occupied": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      },
      "progress": {
        "$orderId": {
          ".validate": "newData.hasChildren(['table', 'createdAt', 'stage', 'paid', 'updatedAt'])",
          "orderNo": { ".validate": "newData.isString()" },
          "table": { ".validate": "newData.isString() && newData.val().length > 0" },
          "total": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "stage": { ".validate": "newData.isString() && newData.val().matches(/^(placed|preparing|ready|served)$/)" },
          "placedAt": { ".validate": "newData.isNumber()" },
          "preparingAt": { ".validate": "newData.isNumber()" },
          "readyAt": { ".validate": "newData.isNumber()" },
          "servedAt": { ".validate": "newData.isNumber()" },
          "paid": { ".validate": "newData.isBoolean()" },
          "paidAt": { ".validate": "newData.isNumber()" },
          "billNo": { ".validate": "newData.isString()" },
          "updatedAt": { ".validate": "newData.isNumber()" }
        }
      },
      "history": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$orderId": {
            ".validate": "newData.hasChildren(['table', 'createdAt', 'stage', 'closedAt'])",
            "stage": { ".validate": "newData.val() === 'served'" },
            "closedAt": { ".validate": "newData.isNumber()" }
          }
        }
      },
      "$other": { ".validate": false }
    }
  }
}
