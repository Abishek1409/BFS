{
  "name": "possiflow-print-server",
  "version": "1.0.0",
  "description": "Local print server for Possiflow thermal printer - bypasses CORS restrictions",
  "main": "print-server.js",
  "scripts": {
    "build": "esbuild map3d/index.js --bundle --format=esm --platform=browser --target=es2020 --loader:.js=jsx --jsx=automatic --outfile=dist/map3d.js",
    "start": "node print-server.js",
    "dev": "nodemon print-server.js",
    "test": "node --test test/dual-printer.test.js",
    "test-deployment": "node --test test/deployment-verification.test.js",
    "test-all": "node --test test/*.test.js test/deployment-verification.test.js"
  },
  "keywords": [
    "possiflow",
    "thermal-printer",
    "print-server",
    "escpos"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "nodemon": "^3.0.1"
  }
}
